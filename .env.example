# Browser Hand — Clerk
# Copy to .env at the repo root:  cp .env.example .env
# Never commit .env. Rebuild the extension after changing any WXT_ value
# (`npm run build:extension`); those are inlined at build time.
#
# WXT only exposes variables prefixed with WXT_ to the extension bundle.
# CLERK_SECRET_KEY has no WXT_ prefix, so it stays in the Node brand script.

# Public. Clerk Dashboard → API keys → Chrome extension → Publishable key.
WXT_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Frontend API URL from the same API keys page.
# Optional. Added as an explicit host permission when set.
WXT_CLERK_FRONTEND_API=https://your-subdomain.clerk.accounts.dev

# Optional. Set only when a website should share this Clerk session with the extension.
# Development example: http://localhost:3000
# Production example: https://app.example.com
WXT_CLERK_SYNC_HOST=

# Optional. Pins the unpacked extension id (manifest "key"). Public key only.
# Never put the Chrome Web Store private key here.
WXT_EXTENSION_PUBLIC_KEY=

# Secret. Server-side only. Used by `npm run clerk:brand` to set allowed origins.
CLERK_SECRET_KEY=sk_test_replace_me

# Extension id from chrome://extensions (32 characters, a-p), without the chrome-extension:// prefix.
CLERK_EXTENSION_ID=

# Optional extra origins to keep when the brand script rewrites allowed_origins.
# CLERK_EXTRA_ALLOWED_ORIGINS=https://app.example.com

# Optional Platform API credentials. When CLERK_APPLICATION_ID is set, `npm run clerk:brand`
# renames the Clerk application to "Browser Hand" and uploads the glove logo.
# The Platform API may require its own token and may need to be enabled for the account.
# CLERK_PLATFORM_SECRET_KEY=
# CLERK_APPLICATION_ID=app_replace_me

# Optional path to a PNG used as the Clerk application logo. Defaults to the glove mark.
# CLERK_LOGO_PATH=docs/brand/derived/mark-transparent-512.png

# Optional. When set, the account page loads orders from this URL instead of sample data.
# See README "Order history".
# WXT_ORDER_HISTORY_URL=https://orders.example.com/v1/orders
