{
  "name": "browser-hand",
  "version": "0.2.9",
  "description": "Browser Hand — agent control of your real Chrome (Path A extension) plus upstream sandboxed CLI. Fork of SawyerHood/dev-browser.",
  "type": "module",
  "bin": {
    "browser-hand": "./bin/dev-browser.js",
    "dev-browser": "./bin/dev-browser.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "version:sync": "node scripts/sync-version.js",
    "version": "npm run version:sync && git add cli/Cargo.toml cli/Cargo.lock .claude-plugin/marketplace.json"
  },
  "files": [
    "bin/",
    "scripts/",
    "daemon/dist/",
    "README.md",
    "FORK.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "quickjs-emscripten": "^0.32.0"
  },
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "cli",
    "sandbox",
    "quickjs",
    "chrome-extension",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verygoodplugins/browser-hand.git"
  },
  "author": "Very Good Plugins",
  "contributors": [
    "Sawyer Hood (upstream dev-browser)"
  ]
}
