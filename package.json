{
  "name": "browser-hand",
  "version": "0.2.9",
  "description": "Browser Hand \u2014 agents control your real logged-in Chrome via a local extension bridge. Fork of SawyerHood/dev-browser.",
  "type": "module",
  "bin": {
    "browser-hand": "./cli-js/bin/browser-hand.js",
    "dev-browser": "./bin/dev-browser.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "version:sync": "node scripts/sync-version.js",
    "version": "npm run version:sync && git add cli/Cargo.toml cli/Cargo.lock .claude-plugin/marketplace.json",
    "build:relay": "npm run build -w browser-hand-relay",
    "build:extension": "npm run build -w browser-hand-extension",
    "build": "npm run build:relay && npm run build:extension",
    "setup": "bash scripts/setup.sh",
    "browser-hand": "node cli-js/src/cli.js",
    "doctor": "node cli-js/src/cli.js doctor",
    "relay": "node cli-js/src/cli.js relay",
    "smoke:live": "bash scripts/smoke-live.sh",
    "gym:compare": "node cli-js/src/gym-compare.js",
    "install:extension": "bash scripts/setup.sh",
    "cli": "node cli-js/src/cli.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "daemon/dist/",
    "README.md",
    "FORK.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "puppeteer-core": "^24.43.1",
    "quickjs-emscripten": "^0.32.0"
  },
  "keywords": [
    "browser",
    "chrome",
    "extension",
    "agent",
    "automation",
    "playwright",
    "logged-in",
    "cli",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verygoodplugins/browser-hand.git"
  },
  "author": "Very Good Plugins",
  "contributors": [
    "Sawyer Hood (upstream dev-browser)"
  ],
  "private": true,
  "workspaces": [
    "relay",
    "cli-js",
    "extension"
  ]
}
