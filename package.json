{
  "name": "browser-hand",
  "version": "0.2.9",
  "description": "Browser Hand \u2014 agent control of your real Chrome (Path A extension) plus upstream sandboxed CLI. Fork of SawyerHood/dev-browser.",
  "type": "module",
  "bin": {
    "browser-hand": "./path-a/bin/browser-hand.js",
    "dev-browser": "./bin/dev-browser.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "version:sync": "node scripts/sync-version.js",
    "version": "npm run version:sync && git add cli/Cargo.toml cli/Cargo.lock .claude-plugin/marketplace.json",
    "build:relay": "npm run build -w browser-hand-relay",
    "build:extension": "npm run build -w browser-hand-extension",
    "build:path-a": "npm run build:relay",
    "build": "npm run build:relay && npm run build:extension",
    "path-a": "node path-a/src/cli.js",
    "doctor": "node path-a/src/cli.js doctor",
    "relay": "node path-a/src/cli.js relay",
    "smoke:live": "bash scripts/smoke-live.sh",
    "install:path-a": "bash scripts/install-path-a.sh"
  },
  "files": [
    "bin/",
    "scripts/",
    "daemon/dist/",
    "README.md",
    "FORK.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "quickjs-emscripten": "^0.32.0"
  },
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "cli",
    "sandbox",
    "quickjs",
    "chrome-extension",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verygoodplugins/browser-hand.git"
  },
  "author": "Very Good Plugins",
  "contributors": [
    "Sawyer Hood (upstream dev-browser)"
  ],
  "private": true,
  "workspaces": [
    "relay",
    "path-a",
    "extension"
  ]
}
