#!/bin/bash
set -euo pipefail
source_path="$0"
if [[ -L "$source_path" ]]; then source_path="$(readlink "$source_path")"; fi
resources="$(cd "$(dirname "$source_path")/.." && pwd -P)"
export DEV_BROWSER_RELAY_PORT="${DEV_BROWSER_RELAY_PORT:-19334}"
export BROWSER_HAND_SAFARI_STANDALONE=1
export BROWSER_HAND_RELAY_BIN="$resources/bin/browser-hand-safari-relay"
exec "$resources/runtime/node" "$resources/cli/cli.js" "$@"
